# Private signing key — NEVER commit. This is what proves ownership of the
# extension ID. (The manifest's "key" field is only the matching PUBLIC key,
# and the OAuth client_id is a public identifier — both ship with the extension,
# exactly as they do in any published Chrome extension.)
key.pem
key.pem.backup
*.pem

# Build output
*.zip

# OS noise
.DS_Store
Thumbs.db

# Store packaging staging
dist/
